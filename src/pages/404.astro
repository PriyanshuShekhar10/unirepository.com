---
import Base from "@/layouts/Base.astro";

const description =
  "This UniRepository page could not be found. Try the GCU hub, A–Z index, search, or home.";
const pageUrl = new URL("/404/", Astro.site).href;
const homeUrl = new URL("/", Astro.site).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: homeUrl },
    { "@type": "ListItem", position: 2, name: "Page not found", item: pageUrl },
  ],
};
---

<Base title="Page not found" description={description} noindex={true} jsonLd={jsonLd}>
  <div class="doc mx-auto max-w-[820px] px-5 py-8 sm:py-10">
    <nav aria-label="Breadcrumb" class="ui mb-4 text-sm text-mute">
      <a href="/" class="hover:underline">Home</a>
      <span aria-hidden="true"> › </span>
      <span>Page not found</span>
    </nav>

    <header class="border-b border-hairline pb-4">
      <p class="ui text-sm text-mute">Error 404</p>
      <h1 class="mt-2 text-3xl font-bold leading-tight text-ink sm:text-4xl">
        This page could not be found.
      </h1>
      <p class="mt-2 max-w-prose text-body">
        The address may be mistyped, the entry may have moved, or this URL was
        never published. UniRepository does not host GCU portal, Halo, or login
        pages — those live on{" "}
        <a href="https://www.gcu.edu/" class="doclink">gcu.edu</a>.
      </p>
    </header>

    <ul class="mt-6 max-w-prose list-disc space-y-2 pl-5 text-body marker:text-mute">
      <li>
        <a href="/wiki/grand-canyon-university/" class="doclink"
          >Grand Canyon University (GCU) hub</a
        >
      </li>
      <li>
        <a href="/wiki/a-z/" class="doclink">A–Z index</a>
      </li>
      <li>
        <a href="/wiki/search/" class="doclink">Search</a>
      </li>
      <li>
        <a href="/" class="doclink">Home</a>
      </li>
      <li>
        <a href="/contact/" class="doclink">Contact us</a> if you think this is a
        broken link on our side
      </li>
    </ul>
  </div>
</Base>
