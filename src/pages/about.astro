---
import Base from "@/layouts/Base.astro";
import { wikiCounts, getCategories } from "@/lib/wiki";

const categories = getCategories();
const description =
  "About UniRepository — an independent encyclopedia of universities, starting with Grand Canyon University (GCU).";
---

<Base title="About" description={description}>
  <div class="doc mx-auto max-w-[820px] px-5 py-8 sm:py-10">
    <nav aria-label="Breadcrumb" class="ui mb-4 text-sm text-mute">
      <a href="/" class="hover:underline">Home</a>
      <span aria-hidden="true"> › </span>
      <span>About</span>
    </nav>

    <header class="border-b border-hairline pb-4">
      <h1 class="text-3xl font-bold leading-tight text-ink sm:text-4xl">
        About
      </h1>
      <p class="mt-2 max-w-prose text-body">
        A sourced, encyclopedia-style guide to universities. We are not a
        university, and we do not collect applications.
      </p>
    </header>

    <div class="mt-6 flex max-w-prose flex-col gap-4 text-body">
      <p>
        UniRepository currently holds{" "}
        <strong class="text-ink">{wikiCounts.pages}</strong> entries across{" "}
        {categories.length} categories. The first hub is{" "}
        <a href="/wiki/grand-canyon-university/" class="doclink"
          >Grand Canyon University (GCU)</a
        >. Short forms such as GCU redirect to that canonical article.
      </p>

      <h2 class="mt-4 text-xl font-bold text-ink">What it covers</h2>
      <ul class="list-disc space-y-1 pl-5 marker:text-mute">
        {
          categories.map((cat) => (
            <li>
              <a href={`/wiki/category/${cat.slug}/`} class="doclink">
                {cat.name}
              </a>{" "}
              — {cat.blurb}
            </li>
          ))
        }
      </ul>

      <h2 class="mt-4 text-xl font-bold text-ink">How entries are built</h2>
      <p>
        Numbers come from public datasets (especially College Scorecard) and
        editorial source files with a retrieval date. Prose headings are
        generated one section at a time and checked against those facts. Code
        blocks — infobox figures, maps, comparison tables, CTA URLs — are never
        written by a model. See{" "}
        <a href="/methodology/" class="doclink">methodology</a>.
      </p>

      <h2 class="mt-4 text-xl font-bold text-ink">Independence</h2>
      <p>
        This project is independent. It is not affiliated with, endorsed by, or
        sponsored by Grand Canyon University or any other school named here.
        Apply, visit, and request-info buttons are outbound links to official
        school websites.
      </p>

      <h2 class="mt-4 text-xl font-bold text-ink">Accuracy</h2>
      <p>
        We work to keep entries accurate, but this is a summarized reference and
        may contain errors. Nothing here is legal, financial, immigration, or
        admissions advice. Please{" "}
        <a href="/contact/" class="doclink">report mistakes</a>.
      </p>
    </div>

    <p class="ui mt-8 text-sm text-mute">
      Related: <a href="/methodology/" class="doclink">Methodology</a> ·
      <a href="/faq/" class="doclink">FAQ</a> ·
      <a href="/contact/" class="doclink">Contact</a>
    </p>
  </div>
</Base>
