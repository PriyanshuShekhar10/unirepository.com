---
import Base from "@/layouts/Base.astro";

const description =
  "Something went wrong on UniRepository. Try again, go home, or contact us if it persists.";
const pageUrl = new URL("/500/", Astro.site).href;
const homeUrl = new URL("/", Astro.site).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: homeUrl },
    { "@type": "ListItem", position: 2, name: "Server error", item: pageUrl },
  ],
};
---

<Base title="Server error" description={description} noindex={true} jsonLd={jsonLd}>
  <div class="doc mx-auto max-w-[820px] px-5 py-8 sm:py-10">
    <nav aria-label="Breadcrumb" class="ui mb-4 text-sm text-mute">
      <a href="/" class="hover:underline">Home</a>
      <span aria-hidden="true"> › </span>
      <span>Server error</span>
    </nav>

    <header class="border-b border-hairline pb-4">
      <p class="ui text-sm text-mute">Error 500</p>
      <h1 class="mt-2 text-3xl font-bold leading-tight text-ink sm:text-4xl">
        Something went wrong on our end.
      </h1>
      <p class="mt-2 max-w-prose text-body">
        An unexpected error occurred while loading this page. Wait a moment and
        try again. This is a static encyclopedia, so most visits never hit a
        server error; if you keep seeing this, the host is having trouble serving
        the site.
      </p>
    </header>

    <ul class="mt-6 max-w-prose list-disc space-y-2 pl-5 text-body marker:text-mute">
      <li>
        <a href="/" class="doclink">Home</a>
      </li>
      <li>
        <a href="/wiki/grand-canyon-university/" class="doclink"
          >Grand Canyon University (GCU) hub</a
        >
      </li>
      <li>
        <a href="/wiki/a-z/" class="doclink">A–Z index</a>
      </li>
      <li>
        <a href="/wiki/search/" class="doclink">Search</a>
      </li>
      <li>
        <a href="/contact/" class="doclink">Contact us</a> if the problem persists
      </li>
    </ul>
  </div>
</Base>
