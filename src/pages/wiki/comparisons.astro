---
import Base from "@/layouts/Base.astro";
import { allPages, displayTitle, stripWikitext } from "@/lib/wiki";

const entries = allPages()
  .filter((p) => p.type === "comparison" && p.status === "complete")
  .sort((a, b) => a.title.localeCompare(b.title, "en"));

const homeUrl = new URL("/", Astro.site).href;
const pageUrl = new URL("/wiki/comparisons/", Astro.site).href;
const description =
  "Head-to-head university comparisons from College Scorecard. One article per pair.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "University comparisons",
    description,
    url: pageUrl,
    inLanguage: "en",
    hasPart: entries.map((e) => ({
      "@type": "Article",
      headline: displayTitle(e.title),
      url: new URL(`/wiki/${e.slug}/`, Astro.site).href,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: homeUrl },
      {
        "@type": "ListItem",
        position: 2,
        name: "Comparisons",
        item: pageUrl,
      },
    ],
  },
];
---

<Base title="University comparisons" description={description} jsonLd={jsonLd}>
  <div class="doc mx-auto max-w-[820px] px-5 py-8 sm:py-10">
    <nav aria-label="Breadcrumb" class="ui mb-4 text-sm text-mute">
      <a href="/" class="hover:underline">Home</a>
      <span aria-hidden="true"> › </span>
      <span>Comparisons</span>
    </nav>
    <header class="border-b border-hairline pb-4">
      <h1 class="text-3xl font-bold leading-tight text-ink sm:text-4xl">
        University comparisons
      </h1>
      <p class="mt-2 text-body">{description}</p>
      <p class="ui mt-1 text-sm text-mute">{entries.length} articles</p>
    </header>
    {
      entries.length === 0 ? (
        <p class="mt-6 text-body">
          Comparison articles appear here after both school hubs are complete
          and the pair passes a uniqueness check.
        </p>
      ) : (
        <ul class="mt-6 flex flex-col gap-4">
          {entries.map((e) => (
            <li>
              <a href={`/wiki/${e.slug}/`} class="doclink text-lg font-bold">
                {displayTitle(e.title)}
              </a>
              <p class="mt-0.5 text-[15px] leading-relaxed text-body">
                {stripWikitext(e.summary)}
              </p>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>
